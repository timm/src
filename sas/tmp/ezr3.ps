x0 y0 moveto
(--## trees -----------------------------------------------------) p n
(-- Recursive best-cut trees over the discretizer above, plus) N
(-- walk/sides: visit every pruning of a grown tree.) N
(function Tree\(tbl,rows,Y,acc,    recurse\)) N
(  function recurse\(rows,lvl,    ys,t,b,c,yes,no\)) N
(    ys = adds\(map\(rows, Y\), acc\(\)\)) N
(    t  = new\(TREE, {at=nil, v=nil, mu=ys:mid\(\), leafs=1,) N
(                    here = tbl:clone\(rows\),) N
(                    loss = ys.has and ys:div\(\) or ys:mid\(\)}\)) N
(    t.val = t.loss) N
(    if #rows >= 2*the.leaf and lvl < the.maxd then) N
(      b = tbl:bestcut\(rows, Y, acc, least\(\)\)) N
(      if b then) N
(        c = tbl.cols.all[b[2]]) N
(        yes, no = tbl:divide\(rows, c, b[3]\)) N
(        if #yes > 0 and #no > 0 then) N
(          t.at, t.v = b[2], b[3]) N
(          t.yes   = recurse\(yes, lvl+1\)) N
(          t.no    = recurse\(no,  lvl+1\)) N
(          t.val   = min\(t.yes.val, t.no.val\)) N
(          t.leafs = t.yes.leafs + t.no.leafs end end end) N
(    return t) N
(  end -- recurse) N
(  Y   = Y or function\(r\) return tbl:disty\(r\) end) N
(  acc = acc or Num) N
(  return recurse\(rows, 0\) end) N
() N
(function TREE.leafed\(x\) -- x, collapsed to one leaf) N
(  return new\(TREE, {at=nil, mu=x.mu, loss=x.loss,) N
(                    val=x.loss, leafs=1, here=x.here}\) end) N
() N
(function TREE.walk\(t,fun\) -- fun on every pruning of tree t) N
(  if t.at == nil then return fun\(t\) end) N
(  t.yes:sides\(function\(yes\)) N
(    t.no:sides\(function\(no\)) N
(      fun\(new\(TREE, {at=t.at, v=t.v, here=t.here,) N
(                     yes=yes, no=no,) N
(                     val=min\(yes.val, no.val\),) N
(                     leafs=yes.leafs + no.leafs}\)\) end\) end\) end) N
() N
(function TREE.sides\(t,fun\) -- t as leaf; then t's prunings) N
(  fun\(t:leafed\(\)\)) N
(  if t.at ~= nil then t:walk\(fun\) end end) N
() N
(function TREE.leaf\(t,tbl,row,    c\) -- row's leaf, its guess) N
(  while t.at do) N
(    c = tbl.cols.all[t.at]) N
(    t = c:holds\(row[t.at], t.v\) and t.yes or t.no end) N
(  return t.mu end) N
() N
(--## tree show -------------------------------------------------) N
(-- One row per node: n, d2h, then each goal's mean under its) N
(-- own header column; tree structure trails on the right.) N
(function TREE.leaves\(t,fun\) -- fun on every leaf below t) N
(  if t.at then t.yes:leaves\(fun\)) N
(               t.no:leaves\(fun\)) N
(  else fun\(t\) end end) N
() N
(function TREE.gstr\(t\) -- goal means, as aligned columns) N
(  return table.concat\(map\(t.here.cols.y, function\(g,    v\)) N
(    v = g:mid\(\)) N
(    if type\(v\) == "number" and v % 1 ~= 0 then) N
(      v = \("%."..the.round.."f"\):format\(v\) end) N
(    return \("%9s"\):format\(v\) end\)\) end) N
() N
(function TREE.show\(t,tbl,    lo,hi,recurse\)) N
(  function recurse\(t,pre,txt,    c,say,m\)) N
(    m = \(t.at == nil and t.mu == lo and "*"\) or -- best leaf) N
(        \(t.at == nil and t.mu == hi and "!"\) or " " -- worst) N
(    print\(\("%s%4d %5.2f%s  %s"\):format\() N
(      m, #t.here.rows, t.mu, t:gstr\(\), pre .. txt\)\)) N
(    if t.at then                     -- structure right) N
(      c   = tbl.cols.all[t.at]) N
(      say = function\(op\)) N
(              return c.name .. op .. tostring\(t.v\) end) N
(      pre = pre .. \(txt == "" and "" or "|  "\)) N
(      recurse\(t.yes, pre, say\(c.has and " == " or " <= "\)\)) N
(      recurse\(t.no,  pre, say\(c.has and " ~= " or " >  "\)\)) N
