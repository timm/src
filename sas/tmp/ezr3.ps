(--## tables ----------------------------------------------------) p n
(function Tbl\(src,    names,all,x,y\) -- row 1 names columns) N
(  src = iter\(src\)) N
(  names, all, x, y = src\(\), {}, {}, {}) N
(  for at, s in ipairs\(names\) do) N
(    all[at] = Col\(s, at\)) N
(    if s:find"[+-]$" then y[#y+1] = all[at]) N
(    elseif s:sub\(-1\) ~= "X" then x[#x+1] = all[at] end end) N
(  return adds\(src, new\(TBL, {rows={}, mid=nil,) N
(                 cols=new\(COLS,) N
(                   {names=names, all=all, x=x, y=y}\)}\)\) end) N
() N
(function COLS.add\(i,row\) -- fold a row into every column) N
(  for _, c in ipairs\(i.all\) do c:add\(row[c.at]\) end) N
(  return row end) N
() N
(function TBL.add\(i,row\) -- keep the row; update summaries) N
(  i.rows[#i.rows+1] = i.cols:add\(row\)) N
(  i.mid = nil) N
(  return row end) N
() N
(function adds\(src,i\) -- fold list or iterator; Num default) N
(  i = i or Num\(\)) N
(  for v in iter\(src or {}\) do i:add\(v\) end) N
(  return i end) N
() N
(function TBL.clone\(i,rows\) -- same header, fresh summaries) N
(  return adds\(rows, Tbl{i.cols.names}\) end) N
() N
(function TBL.mids\(i\) -- return centroid of this tbl) N
(  i.mid = i.mid or map\(i.cols.all,function\(c\) return c:mid\(\)end\)) N
(  return i.mid end) N
() N
