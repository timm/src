(  c:cuts\(xy, tot, acc, best\) end) p n
() N
(function TBL.bestcut\(i,rows,Y,acc,best\) -- champion x-col cut) N
(  for _,c in ipairs\(i.cols.x\) do i:cuts\(rows,c,Y,acc,best\) end) N
(  return best\(\) end) N
() N
(function TBL.divide\(i,rows,c,v,    yes,no\) -- rows into holds) N
(  yes, no = {}, {}                         -- c<=v, or not) N
(  for _,r in ipairs\(rows\) do) N
(    push\(c:holds\(r[c.at], v\) and yes or no, r\) end) N
(  return yes, no end) N
() N
