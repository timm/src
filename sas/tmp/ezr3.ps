iso1dict begin
gsave
llx lly 12 add translate
/v 0 store
/x0 x v get 2.707221 add sx cw mul add store
/y0 y v get bfs th add sub store
x0 y0 moveto
(--## distance --------------------------------------------------) p n
(function SYM.dist\(i,a,b\) -- gap between two syms; 0..1) N
(  if a == "?" and b == "?" then return 1 end) N
(  return a ~= b and 1 or 0 end) N
() N
(function NUM.dist\(i,a,b\) -- gap between two nums; 0..1) N
(  if a == "?" and b == "?" then return 1 end) N
(  a, b = i:norm\(a\), i:norm\(b\)) N
(  if a == "?" then a = b > 0.5 and 0 or 1 end) N
(  if b == "?" then b = a > 0.5 and 0 or 1 end) N
(  return abs\(a - b\) end) N
() N
(function minkowski\(cols,f,    d,n\) -- p-norm mean of f\(col\)) N
(  d, n = 0, TINY) N
(  for _, c in ipairs\(cols\) do n, d = n+1, d + f\(c\) ^ the.p end) N
(  return \(d / n\) ^ \(1 / the.p\) end) N
() N
(function TBL.distx\(i,row1,row2\) -- gap over x cols; 0..1) N
(  return minkowski\(i.cols.x, function\(c\)) N
(           return c:dist\(row1[c.at], row2[c.at]\) end\) end) N
() N
(function TBL.disty\(i,row\) -- gap to heaven; 0=best) N
(  return minkowski\(i.cols.y, function\(y\)) N
(           return abs\(y:norm\(row[y.at]\) - y.heaven\) end\) end) N
() N
(--## clusters --------------------------------------------------) N
(function TBL.projx\(i,row,a,b,c\) -- onto the a-b line) N
(  return \(i:distx\(a,row\)^2 + c*c) N
(          - i:distx\(b,row\)^2\) / \(2*c + TINY\) end) N
() N
(function TBL.halve\(i,rows,    far,a,b,c,n\)) N
(  rows = rows or i.rows     -- split on far poles, best first) N
(  far = function\(r,    t\)) N
(          t = keysort\(some\(rows, the.few\),) N
(                function\(r2\) return i:distx\(r, r2\) end\)) N
(          return t[#t] end) N
(  a = far\(rows[rand\(#rows\)]\)) N
(  b = far\(a\)) N
(  c = i:distx\(a, b\)) N
(  if i:disty\(b\) < i:disty\(a\) then a, b = b, a end) N
(  rows = keysort\(rows, function\(r\) return i:projx\(r,a,b,c\) end\)) N
(  n = floor\(#rows / 2\)) N
(  return a, b, sub\(rows, 1, n\), sub\(rows, n + 1\) end) N
() N
(function Node\(tbl,rows,    recurse\) -- tree of halves) N
(  function recurse\(rows,    node,a,b,lo,hi\)) N
(    node = new\(NODE, {here=tbl:clone\(rows\),) N
(                      a=nil, b=nil, lo=nil, hi=nil}\)) N
(    if #rows >= 2 * the.stop then) N
(      a, b, lo, hi = tbl:halve\(rows\)) N
(      node.a, node.b = a, b) N
(      if #lo > 0 and #hi > 0 then) N
(        node.lo, node.hi = recurse\(lo\), recurse\(hi\) end end) N
(    return node) N
(  end -- recurse) N
(  return recurse\(rows or tbl.rows\) end) N
() N
(function NODE.leaf\(i,row,    t\) -- walk row down to its leaf) N
(  while i.lo do) N
(    t = i.here) N
(    i = t:distx\(row, i.a\) <= t:distx\(row, i.b\)) N
(        and i.lo or i.hi end) N
(  return i end) N
() N
