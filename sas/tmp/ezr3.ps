(  end -- recurse) N
(  lo, hi = huge, -huge     -- leaf extremes,) N
(  t:leaves\(function\(l\)               -- then a header) N
(    lo, hi = min\(lo, l.mu\), max\(hi, l.mu\) end\)) N
(  print\(\(" %4s %5s"\):format\("n", "d2h"\) ..) N
(    table.concat\(map\(t.here.cols.y, function\(g\)) N
(      return \("%9s"\):format\(g.name\) end\)\)\)) N
(  recurse\(t, "", ""\) end) N
() N
