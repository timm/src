(#!/usr/bin/env lua) p n
(local help = [[) N
(ezr3.lua: lib.py's substrate said in Lua: multi-goal trees) N
(plus active learning. Score rig, stats and demos live next) N
(door in ezr3-eg.lua; the batteries below, in lib.lua.) N
(Columns index from 1, not 0; everything else mirrors the) N
(Python.) N
() N
(usage:) N
(  lua ezr3-eg.lua [-h] [--key=val ..] [--demo ..]) N
() N
(or, adding demos from your own script:) N
(  local ezr = require"ezr3-eg") N
(  ezr.eg["--myDemo"] = function\(\) print\(ezr.the.seed\) end) N
(  ezr.go\(ezr.eg\)) N
() N
(inference options:) N
(  budget=50    acquire: max labels) N
(  cap=1024     holdout: max rows kept) N
(  check=5      holdout: test rows labelled) N
(  few=128      sample size for cheap guesses) N
(  keepf=0.66   acquire: pool kept per cull) N
(  leaf=3       tree: min rows in one leaf) N
(  maxd=4       tree: max depth) N
(  more=4       acquire: labels per round) N
(  p=2          minkowski coefficient) N
(  stop=32      min rows before a split halts]]) N
() N
(local abs,exp,log,sqrt = math.abs,math.exp,math.log,math.sqrt) N
(local max,min,floor    = math.max,math.min,math.floor) N
(local huge,rand        = math.huge,math.random) N
(local TINY             = 1e-32) N
() N
(-- find lib.lua beside this file, whatever the cwd) N
(package.path = \(arg and arg[0] or ""\):gsub\("[^/]*$",""\)) N
(               .. "?.lua;" .. package.path) N
(local lib = require"lib") N
() N
(-- all defs below land here; reads fall through to lib) N
(-- \(and, through lib, to _G\)) N
(local _ENV = setmetatable\({}, {__index = lib}\)) N
(if setfenv then setfenv\(1, _ENV\) end) N
() N
(the = the:also\(help\)) N
() N
() N
(ezr3.lua) (Page 1/8) (Aug 04, 2026 16:44) title
border
/v 1 store
/x0 x v get 2.707221 add sx cw mul add store
/y0 y v get bfs th add sub store
x0 y0 moveto
(--## columns ---------------------------------------------------) p n
(NUM, SYM, COLS, TBL, NODE, TREE = {},{},{},{},{},{}) N
() N
(function Col\(name,at\) -- column kind from first letter) N
(  return \(name:find"^%l" and Sym or Num\)\(name,at\) end) N
() N
(function Num\(name,at\) -- summary of a numeric column) N
(  name = name or "") N
(  return new\(NUM, {at=at or 1, name=name, n=0, mu=0, m2=0,) N
(                   heaven = name:find"-$" and 0 or 1}\) end) N
() N
(function Sym\(name,at\) -- summary of a symbolic column) N
(  return new\(SYM, {at=at or 1, name=name or "", n=0, has={}}\) end) N
() N
(function SYM.add\(i,v\) -- update symbol counts) N
(  if v == "?" then return v end) N
(  i.n = i.n + 1; i.has[v] = 1 + \(i.has[v] or 0\); return v end) N
() N
(function NUM.add\(i,v,    d\) -- one-pass update of mu and m2) N
(  if v == "?" then return v end) N
(  i.n  = i.n + 1) N
(  d    = v - i.mu) N
(  i.mu = i.mu + d / i.n) N
(  i.m2 = i.m2 + d * \(v - i.mu\); return v end) N
() N
(function SYM.mid\(i,    hi,out\) -- center: the mode) N
(  hi = -1) N
(  for k, n in pairs\(i.has\) do) N
(    if n > hi then hi, out = n, k end end) N
(  return out end) N
() N
(function NUM.mid\(i\) return i.mu end -- center: the mean) N
() N
(function SYM.div\(i\) -- diversity: entropy of the counts) N
(  return sum\(i.has, function\(n,    p\)) N
(    p = n / i.n; return -p * log\(p, 2\) end\) end) N
() N
(function NUM.div\(i\) -- diversity: standard deviation) N
(  return i.n < 2 and 0 or sqrt\(max\(i.m2,0\) / \(i.n-1\)\) end) N
() N
(function SYM.norm\(i,v\) return v end -- syms have no cdf) N
() N
(function NUM.norm\(i,v,    z\) -- v's cdf, via logistic; 0..1) N
(  if v == "?" then return v end) N
(  z = \(v - i.mu\) / \(i:div\(\) + TINY\)) N
(  return 1 / \(1 + exp\(-1.702 * max\(-3, min\(3, z\)\)\)\) end) N
() N
(function NUM.without\(i,j,    n,d\) -- i minus j, as new NUM) N
(  n = i.n - j.n) N
(  if n < 1 then return Num\(i.name, i.at\) end) N
(  d = j.mu - i.mu) N
(  return new\(NUM, {name=i.name, at=i.at, heaven=i.heaven,) N
(                   n=n, mu=\(i.n*i.mu - j.n*j.mu\) / n,) N
(                   m2=max\(0, i.m2 - j.m2) N
(                             - d*d*i.n*j.n/n\)}\) end) N
() N
(function SYM.without\(i,j,    out,n\) -- i minus j's counts) N
(  out = Sym\(i.name, i.at\)) N
(  for k,v in pairs\(i.has\) do) N
(    n = v - \(j.has[k] or 0\)) N
(    if n > 0 then out.has[k] = n; out.n = out.n + n end end) N
(  return out end) N
() N
(function SYM.holds\(i,x,v\) return x == "?" or x == v  end) N
(function NUM.holds\(i,x,v\) return x == "?" or x <= v  end) N
() N
