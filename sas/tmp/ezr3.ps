/v 1 store
/x0 x v get 2.707221 add sx cw mul add store
/y0 y v get bfs th add sub store
x0 y0 moveto
(--## acquire ---------------------------------------------------) p n
(-- Label few rows, cull the pool toward the good pole, loop.) N
(-- lab is a plain list of labelled rows; acquire rebuilds its) N
(-- private seen set \(keyed by row ref\) on each entry. When a) N
(-- pool dries with budget left, acquirer reshuffles and goes) N
(-- again, anchored at the best and worst labels seen so far.) N
(function TBL.poles\(i,rows,east,west,    x,y,far,c\) -- rows ->) N
(  x = function\(a,b\) return i:distx\(a, b\) end -- projector on) N
(  y = function\(r\)   return i:disty\(r\)   end -- east-west line) N
(  far  = function\(r,    t\)) N
(           t = keysort\(rows, function\(z\) return x\(z,r\) end\)) N
(           return t[#t] end) N
(  east = east or far\(rows[1]\)) N
(  west = west or far\(east\)) N
(  if y\(east\) > y\(west\) then east, west = west, east end) N
(  c = x\(east, west\) + TINY) N
(  return function\(r\)) N
(    return \(x\(east,r\)^2 + c*c - x\(west,r\)^2\) / \(2*c\) end end) N
() N
(function TBL.acquire\(i,rows,cap,lab,east,west,) N
(                     seen,more,new\)) N
(  seen = {}) N
(  for _,r in ipairs\(lab\) do seen[r] = true end) N
(  while #rows >= 2*the.leaf do) N
(    more, new = min\(the.more, cap - #lab\), {}) N
(    for _,r in ipairs\(rows\) do -- new = labels in this pool) N
(      if seen[r] then push\(new, r\)) N
(      elseif more > 0 then) N
(        more, seen[r] = more - 1, true) N
(        push\(new, push\(lab, r\)\) end end) N
(    if #lab >= cap then return lab end -- budget spent) N
(    rows = sub\(keysort\(rows, i:poles\(new, east, west\)\),) N
(               1, max\(1, floor\(the.keepf * #rows\)\)\) end) N
(  return lab end) N
() N
(function TBL.acquirer\(i,cap,    lab,east,west,t\)) N
(  lab = {}) N
(  while true do) N
(    lab = i:acquire\(shuffle\(i.rows\), cap, lab, east, west\)) N
(    if #lab >= cap or #lab >= #i.rows then break end) N
(    t = keysort\(lab, function\(r\) return i:disty\(r\) end\)) N
(    east, west = t[1], t[#t] end -- best+worst seen) N
(  return keysort\(lab, function\(r\) return i:disty\(r\) end\) end) N
(  --) N
() N
(--## discretize ------------------------------------------------) N
(-- Find good cuts: places where splitting the x values most) N
(-- purifies some y summary. All candidates feed one `least`) N
(-- reducer; no cut lists are ever built.) N
(function val\(a,b\) -- mean diversity of two summaries) N
(  return \(a:div\(\)*a.n + b:div\(\)*b.n\) / \(a.n + b.n + TINY\) end) N
() N
(function big\(lo,n\) -- both sides of a cut hold >= the.leaf) N
(  return the.leaf <= lo and lo <= n - the.leaf end) N
() N
(function SYM.cuts\(c,xy,tot,acc,best,    d,b\) -- one cut per) N
(  d = {}                                       -- key; feed best) N
(  for _,p in ipairs\(xy\) do) N
(    b = d[p[1]] or acc\(\)) N
(    b:add\(p[2]\); d[p[1]] = b end) N
(  if #keys\(d\) > 1 then) N
(    for k,v in pairs\(d\) do) N
(      if big\(v.n, #xy\) then) N
(        best{val\(v, tot:without\(v\)\), c.at, k} end end end end) N
() N
(function NUM.cuts\(c,xy,tot,acc,best,    here\) -- cuts between) N
(  table.sort\(xy, function\(a,b\) return a[1] < b[1] end\)) N
(  here = acc\(\)                   -- each distinct, sorted x) N
(  for j,p in ipairs\(xy\) do) N
(    here:add\(p[2]\)) N
(    if j < #xy and p[1] ~= xy[j+1][1] and big\(j, #xy\) then) N
(      best{val\(here,tot:without\(here\)\),c.at,p[1]} end end end) N
() N
(function TBL.cuts\(i,rows,c,Y,acc,best,    xy,tot\) -- col c) N
(  xy = {}                        -- feeds its splits to best) N
(  for _,r in ipairs\(rows\) do) N
(    if r[c.at] ~= "?" then push\(xy, {r[c.at], Y\(r\)}\) end end) N
(  tot = adds\(map\(xy, function\(p\) return p[2] end\), acc\(\)\)) N
