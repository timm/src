-include $(shell git rev-parse --show-toplevel)/Makefile

docs/nav.inc: index.md ## shared nav = index's 1st <center>
	@awk '/^<center>/{f=1} f; /^<\/center>/{exit}' $< > $@

docs/index.html: NAV =
docs/%.html:     NAV = -B docs/nav.inc
docs/%.html: %.md docs/head.inc docs/nav.inc
	@pandoc --template=docs/page.tmpl \
	  --syntax-highlighting=none -f markdown \
	  -M pagetitle="ezr: $*" -H docs/head.inc $(NAV) $< -o $@
	@open $@

y3_map.md: y3.py docs/calls.py ## cheat sheet: map + call graph
	@gawk 'BEGIN { \
	   print "## y3.py, mapped"; print ""; \
	   print "Generated by `make y3_map.md`: every section and"; \
	   print "top-level signature, with its one-line comment." } \
	 { gsub(/\f/, "") } \
	 /^#-- / { if (code) { print "```"; code=0 } \
	   t=$$0; sub(/^#-- */,"",t); gsub(/ *-+ *$$/,"",t); \
	   print ""; print "### " t; next } \
	 /^(def |Num =|Sym =|pat =|the =)/ { \
	   if (!code) { print ""; print "```py"; code=1 } \
	   print; \
	   if ($$0 ~ /^def test_/) { getline d; print d } \
	   next } \
	 END { if (code) print "```" }' $< > $@
	@python3 docs/calls.py $< >> $@
	@python3 -c "import ast,statistics as st; \
	 f=[n.end_lineno-n.lineno+1 for n in ast.walk(ast.parse(open('$<').read())) \
	    if isinstance(n,ast.FunctionDef)]; \
	 print(f'\n{len(f)} functions; median {st.median(f):g} lines; longest {max(f)}.')" >> $@
